// Cloudflare Worker serving this folder as static assets (project "coriva").
// not_found_handling: unknown paths get the nearest 404.html with status 404, instead of an empty page.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coriva",
  "compatibility_date": "2026-11-19",
  "previews": {},
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
